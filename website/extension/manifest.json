{
  "manifest_version": 3,
  "name": "SyncFlix",
  "version": "0.3.0",
  "minimum_chrome_version": "111",
  "description": "Synchronizes video playback with your SyncFlix watch-party room.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:4028/*",
        "https://syncflix.netlify.app/*",
        "https://*.netlify.app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.netflix.com/*",
        "https://*.primevideo.com/*",
        "https://*.amazon.com/gp/video/*",
        "https://*.amazon.ca/gp/video/*",
        "https://*.amazon.com.br/gp/video/*",
        "https://*.amazon.com.mx/gp/video/*",
        "https://*.amazon.co.uk/gp/video/*",
        "https://*.amazon.de/gp/video/*",
        "https://*.amazon.fr/gp/video/*",
        "https://*.amazon.it/gp/video/*",
        "https://*.amazon.es/gp/video/*",
        "https://*.amazon.nl/gp/video/*",
        "https://*.amazon.se/gp/video/*",
        "https://*.amazon.pl/gp/video/*",
        "https://*.amazon.com.tr/gp/video/*",
        "https://*.amazon.ae/gp/video/*",
        "https://*.amazon.sa/gp/video/*",
        "https://*.amazon.in/gp/video/*",
        "https://*.amazon.sg/gp/video/*",
        "https://*.amazon.co.jp/gp/video/*",
        "https://*.amazon.com.au/gp/video/*"
      ],
      "js": ["player.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.netflix.com/*"],
      "js": ["netflix-page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SyncFlix",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"]
}
